# =============================================================================
#  ATLAS settings
# =============================================================================
# You don't need this file to get started: on first launch ATLAS shows a setup
# screen, asks for your OpenRouter key and creates ".env" for you.
#
# To configure by hand instead, copy this file to ".env" in the same folder,
# fill in your values, then start ATLAS. Most of these can also be changed
# later in the Settings drawer (gear icon), which saves them back to .env.
#
# How this file works:
#   - One KEY=value per line. Quotes are optional.
#   - Put comments on their own line, starting with #.
#     Wrap a value in double quotes if it contains a # character.
#   - A blank value means "use the default". Optional features stay off while
#     their keys are blank.
#   - An environment variable with the same name overrides the value here.
#   - Restart ATLAS after editing this file by hand. (The browser, calendar,
#     texting and smart-home keys are re-read each time they're used.)
#   - .env is git-ignored. Never share it: it holds your API key, passwords,
#     tokens and secret calendar links.
#   - Every value below is a blank or a harmless default. Examples are in the
#     comments; replace them with your own details.

# --- AI model (OpenRouter) ---------------------------------------------------

# Your OpenRouter API key, from https://openrouter.ai/keys
# Replace the placeholder with your real key (it starts with sk-or-v1-).
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Main chat model as an OpenRouter model id, e.g. anthropic/claude-sonnet-4.5
# Blank = automatic (first available of ATLAS's preferred models).
ATLAS_MODEL=

# Cheaper, faster model for the web-search research step, e.g. google/gemini-2.5-flash
# Blank = automatic.
ATLAS_SEARCH_MODEL=

# --- About you ---------------------------------------------------------------

# The assistant's name. This is also the wake word in wake-word mode.
ASSISTANT_NAME=ATLAS

# Your name, used to personalise replies, sign emails and fill in bookings.
USER_NAME=

# How ATLAS addresses you, e.g. sir, boss, Dr. Lee. Blank = your name.
USER_ADDRESS_AS=

# Home city for weather, "near me" searches and restaurant bookings, e.g. Austin, Texas.
# Blank = weather estimates your location from your IP address.
HOME_CITY=

# imperial (Fahrenheit, mph) or metric (Celsius, km/h).
UNITS=imperial

# --- Your details (optional) -------------------------------------------------
# Used to fill in bookings and forms, and for directions. Blank = ATLAS asks when needed.

# Your phone number, for restaurant bookings and forms, e.g. +1 555 555 0123
USER_PHONE=

# Home address: the default start for directions, and what "home" means.
# Example: HOME_ADDRESS=123 Main St, Austin, TX 78701
# Quote addresses that contain #, e.g. HOME_ADDRESS="500 Main St #4, Austin, TX 78701"
HOME_ADDRESS=

# Work address: what "work" means, as in "How long to drive to work?"
WORK_ADDRESS=

# --- News & markets ----------------------------------------------------------

# Google News country, as a two-letter code: US, GB, CA, AU, IN, ...
NEWS_REGION=US

# Google News language, as a two-letter code: en, es, fr, de, ...
NEWS_LANGUAGE=en

# Tickers for the market ticker, comma-separated, written the way Yahoo Finance does.
# Blank = ^GSPC,^IXIC,^DJI,^VIX,BTC-USD,ETH-USD,GC=F,CL=F,^TNX
# Example: MARKET_WATCHLIST=^GSPC,^IXIC,AAPL,NVDA,MSFT,BTC-USD
MARKET_WATCHLIST=

# --- Email (optional) --------------------------------------------------------

# Your address plus an APP PASSWORD (not your normal password). See README.md, "Email setup".
# Gmail: turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Mail servers. Blank = worked out from your address (Gmail, Outlook/Hotmail, Yahoo,
# iCloud, AOL), otherwise smtp.<your-domain> port 465 and imap.<your-domain> port 993.
# SMTP port 465 uses SSL; any other port (usually 587) uses STARTTLS.
# IMAP always uses SSL/TLS (usually port 993).
SMTP_HOST=
SMTP_PORT=
IMAP_HOST=
IMAP_PORT=

# --- ATLAS's browser (reservations & web tasks) ------------------------------
# ATLAS drives its own Chrome or Edge window and keeps its sign-ins in data/browser-profile.
# Only if neither Chrome nor Edge is installed, run once:
#   .venv/bin/python -m playwright install chromium     (Windows: .venv\Scripts\python ...)
# Changes apply the next time ATLAS opens its browser window.

# Prefer one installed browser: chrome or msedge. Blank = Chrome, then Edge, then Playwright's Chromium.
BROWSER_CHANNEL=

# Full path to a Chromium-based browser to use instead (overrides BROWSER_CHANNEL). Blank = don't.
# Examples: BROWSER_EXECUTABLE=/usr/bin/chromium
#           BROWSER_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
BROWSER_EXECUTABLE=

# true = run with no visible window. Only for computers without a screen: you can't sign in,
# solve a CAPTCHA or watch a booking in a window you can't see.
BROWSER_HEADLESS=false

# Image-capable model for reading screenshots of date pickers, seating maps, etc.
# Blank = the main model. Example: BROWSER_VISION_MODEL=google/gemini-2.5-flash
BROWSER_VISION_MODEL=

# --- Calendar (optional) -----------------------------------------------------
# Secret iCal (ICS) links to your calendars, comma-separated. Read-only. See README.md,
# "Calendar & to-dos", for where to find them. Treat them like passwords.
# Name each one if you like:
#   CALENDAR_ICS_URLS=Personal=https://calendar.google.com/calendar/ical/.../basic.ics,Work=https://outlook.office365.com/owa/calendar/.../calendar.ics
# iCloud's webcal:// links work as-is.
CALENDAR_ICS_URLS=

# Where new events go. You click Save there:
#   google    - Google Calendar opens in the browser, pre-filled (default)
#   outlook   - Outlook.com opens, pre-filled
#   office365 - Outlook for work/school (Microsoft 365) opens, pre-filled
#   ics       - an .ics file opens in your default calendar app (Apple Calendar, desktop Outlook, ...)
#   local     - kept in ATLAS's own calendar only
CALENDAR_PROVIDER=google

# Your usual day, used when looking for free time. Format HH:MM-HH:MM (24-hour).
CALENDAR_DAY_HOURS=08:00-20:00

# --- Texts & calls (optional) ------------------------------------------------
# Texts go through Twilio when all three Twilio keys are set; otherwise, on a Mac, through
# the Messages app (iMessage). Calls open your computer's calling app; you press Call.
# All three values are on the Twilio Console home page (https://console.twilio.com).
# Trial accounts can only text numbers you've verified in the Twilio Console.

# Account SID: 34 characters starting with AC.
TWILIO_ACCOUNT_SID=

# Auth Token. Secret: never shown again by ATLAS once saved.
TWILIO_AUTH_TOKEN=

# Your Twilio number, e.g. +15555550123 (or a Messaging Service SID starting with MG).
TWILIO_FROM_NUMBER=

# Country for numbers written without a leading +: +1 (US/Canada), +44 (UK), +61 (Australia), ...
DEFAULT_COUNTRY_CODE=+1

# --- Smart home: Home Assistant (optional) -----------------------------------

# Where you open Home Assistant, e.g. http://homeassistant.local:8123 or http://192.168.1.20:8123
HOME_ASSISTANT_URL=

# Long-lived access token: in Home Assistant click your name (bottom left) -> Security tab ->
# Long-lived access tokens -> Create token.
HOME_ASSISTANT_TOKEN=

# Extra things that must be approved before ATLAS does them, comma-separated: domains (light),
# services (climate.set_temperature) or devices (switch.space_heater). * = approve everything.
# Locks, alarms, garage doors and other covers, valves, sirens, cameras and any unlock/open/disarm
# action always ask first, whatever this says.
HOME_ASSISTANT_CONFIRM_DOMAINS=

# --- Safety ------------------------------------------------------------------

# Tools that run WITHOUT showing the Approve / Deny card, comma-separated.
# Blank = always ask (recommended). This can only be set here, not in Settings.
# Tools that always ask:
#   send_email, send_text_message, make_phone_call, run_command, read_file,
#   write_file, close_application, power_action, type_text, press_keys
# Tools that ask only for risky actions, whose checks are switched off completely if listed here:
#   browser_click, browser_type, browser_press  (final Book / Pay / Submit clicks)
#   smart_home_control                          (locks, alarms, garage doors, ...)
# Example, at your own risk: AUTO_APPROVE=type_text,press_keys
AUTO_APPROVE=

# Set to false to turn off shell commands (run_command) completely.
ALLOW_SHELL=true

# --- Server ------------------------------------------------------------------

# ATLAS only listens on this computer: 127.0.0.1 or localhost are the only accepted values.
ATLAS_HOST=127.0.0.1

# Port for the web page. If it's busy, the next free port is used automatically.
ATLAS_PORT=8765

# Open your browser automatically when ATLAS starts (true or false).
ATLAS_OPEN_BROWSER=true

# Advanced: the OpenRouter API endpoint. Leave this alone unless you're testing.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
